{
  "id": "evidence.get",
  "version": "1.0",
  "package": "grid_simulator",
  "tool_name": "grid_evidence_get",
  "availability": "published",
  "title": "Get persisted evidence",
  "purpose": "Retrieve a persisted simulator evidence document by reference so final answers can cite concrete artifacts.",
  "applies_to": ["evidence retrieval", "answer grounding", "artifact inspection"],
  "not_for": ["creating new calculations", "modifying evidence", "substituting evidence that does not exist"],
  "terms": {
    "zh": ["证据", "运行产物", "引用", "结果文件"],
    "en": ["evidence", "artifact", "reference", "result file"]
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["evidence_ref"],
    "properties": {
      "evidence_ref": {"type": "string", "pattern": "^evidence:sha256:[0-9a-f]{64}$"}
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["evidence_ref", "document"],
    "properties": {
      "evidence_ref": {"type": "string", "pattern": "^evidence:sha256:[0-9a-f]{64}$"},
      "document": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_type",
          "capability_id",
          "context_ref",
          "revision_ref",
          "provenance"
        ],
        "properties": {
          "evidence_type": {"type": "string", "enum": ["network_fact", "analysis_result", "contingency_scenario", "powerflow_non_convergence"]},
          "capability_id": {"type": "string", "enum": ["topology.branch.endpoints.get", "model.constraints.describe", "analysis.powerflow.ac.run", "analysis.contingency.n_minus_one.run"]},
          "context_ref": {"type": "string", "pattern": "^context:sha256:[0-9a-f]{64}$"},
          "revision_ref": {"type": "string", "pattern": "^revision:sha256:[0-9a-f]{64}$"},
          "subject_ref": {"type": ["string", "null"]},
          "result_ref": {"type": "string", "pattern": "^result:sha256:[0-9a-f]{64}$"},
          "diagnostic": {"type": "string"},
          "allowed_recovery_actions": {"type": "array", "items": {"type": "string"}},
          "facts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from_bus_ref": {"type": "string", "pattern": "^asset:bus:sha256:[0-9a-f]{64}$"},
              "to_bus_ref": {"type": "string", "pattern": "^asset:bus:sha256:[0-9a-f]{64}$"},
              "converged": {"type": "boolean"},
              "total_active_loss": {"type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": {"value": {"type": "number"}, "unit": {"type": "string", "enum": ["MW"]}}},
              "branch_result_count": {"type": "integer", "minimum": 0},
              "status": {"type": "string", "enum": ["succeeded", "partial", "failed", "non_converged"]},
              "max_loading_percent": {"type": "number"},
              "min_vm_pu": {"type": "number"},
              "max_vm_pu": {"type": "number"},
              "violation_count": {"type": "integer", "minimum": 0},
              "constraint_evaluation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "source", "evaluated_quantities", "unevaluated_quantities"],
                "properties": {
                  "status": {"type": "string", "enum": ["evaluated", "partially_evaluated", "not_defined"]},
                  "source": {"type": "string", "enum": ["model"]},
                  "evaluated_quantities": {"type": "array", "items": {"type": "string"}},
                  "unevaluated_quantities": {"type": "array", "items": {"type": "string"}}
                }
              },
              "constraints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["constraint_ref", "quantity", "subject_kind", "lower", "upper", "unit", "applies_to_count", "source"],
                  "properties": {
                    "constraint_ref": {"type": "string", "pattern": "^constraint:sha256:[0-9a-f]{64}$"},
                    "quantity": {"type": "string"},
                    "subject_kind": {"type": "string", "enum": ["bus", "line", "trafo"]},
                    "lower": {"type": ["number", "null"]},
                    "upper": {"type": ["number", "null"]},
                    "unit": {"type": "string"},
                    "applies_to_count": {"type": "integer", "minimum": 0},
                    "source": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "table", "fields"],
                      "properties": {
                        "kind": {"type": "string", "enum": ["model"]},
                        "table": {"type": "string", "enum": ["bus", "line", "trafo"]},
                        "fields": {"type": "array", "items": {"type": "string"}}
                      }
                    }
                  }
                }
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["engine", "engine_version"],
            "properties": {
              "engine": {"type": "string", "enum": ["pandapower"]},
              "engine_version": {"type": "string", "enum": ["3.4.0"]},
              "source_alias": {"type": "string"},
              "source": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "requires": [],
  "consumes": ["evidence.reference"],
  "produces": ["evidence.network_fact"],
  "common_next": [],
  "errors": ["unknown_evidence", "artifact_unreadable"],
  "recovery": {
    "unknown_evidence": ["do not claim evidence; rerun the producing capability if calculation is required"],
    "artifact_unreadable": ["report the unreadable artifact and preserve the original reference"]
  },
  "context_effect": {
    "requires_state": [],
    "consumes_state": ["artifacts.evidence"],
    "produces_state": ["artifacts.observation"],
    "invalidates_state": [],
    "result_kind": null,
    "projector": "artifact-observation-v1"
  },
  "state_effect": "none",
  "evidence_required": false,
  "risk": "read_only_analysis",
  "pandapower": null
}
