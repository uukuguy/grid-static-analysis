{
  "id": "analysis.policy.describe",
  "version": "1.0",
  "package": "grid_simulator",
  "tool_name": "grid_analysis_policy_describe",
  "title": "Describe static-analysis operating limits",
  "purpose": "Return the published numerical operating limits used by a named static-analysis policy without running a network calculation.",
  "applies_to": ["normal voltage range", "branch loading limit", "interpreting N-1 violations"],
  "not_for": ["model-specific voltage results", "real-time operating limits", "replacing a required power-flow calculation"],
  "terms": {
    "zh": ["静态分析策略", "正常电压范围", "线路负载率限值"],
    "en": ["static-analysis policy", "normal voltage range", "branch loading limit"]
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["policy"],
    "properties": {"policy": {"type": "string", "enum": ["static-analysis-v1"]}}
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["policy", "bus_voltage_pu", "branch_loading_percent"],
    "properties": {
      "policy": {"type": "string", "enum": ["static-analysis-v1"]},
      "bus_voltage_pu": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minimum", "maximum"],
        "properties": {"minimum": {"type": "number", "const": 0.95}, "maximum": {"type": "number", "const": 1.05}}
      },
      "branch_loading_percent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["maximum"],
        "properties": {"maximum": {"type": "number", "const": 100.0}}
      }
    }
  },
  "requires": [],
  "consumes": ["static-analysis policy"],
  "produces": ["static-analysis operating limits"],
  "common_next": ["analysis.contingency.n_minus_one.run"],
  "errors": ["unknown_policy"],
  "recovery": {"unknown_policy": ["use static-analysis-v1"]},
  "state_effect": "none",
  "evidence_required": false,
  "risk": "read_only_analysis",
  "pandapower": null
}
