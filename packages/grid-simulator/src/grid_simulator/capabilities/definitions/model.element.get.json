{
  "id":"model.element.get",
  "version":"1.0",
  "package":"grid_simulator",
  "tool_name":"grid_model_element_get",
  "availability":"published",
  "title":"Get a model element",
  "purpose":"Resolve an element from any listed static network table to a stable asset reference and schema-described attributes.",
  "applies_to":["element index lookup","name or alias lookup","stable asset reference resolution"],
  "not_for":["element mutation","calculating results","unlisted internal tables"],
  "terms":{"zh":["元件查询","元件索引","稳定引用"],"en":["element lookup","element index","stable reference"]},
  "input_schema":{"type":"object","additionalProperties":false,"required":["context_ref","kind","namespace","identifier"],"properties":{"context_ref":{"type":"string","pattern":"^context:sha256:[0-9a-f]{64}$"},"kind":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},"namespace":{"type":"string","enum":["pandapower_index","name","alias","asset_ref"]},"identifier":{"type":"string","minLength":1}}},
  "output_schema":{"type":"object","additionalProperties":false,"required":["context_ref","revision_ref","asset_ref","element"],"properties":{"context_ref":{"type":"string","pattern":"^context:sha256:[0-9a-f]{64}$"},"revision_ref":{"type":"string","pattern":"^revision:sha256:[0-9a-f]{64}$"},"asset_ref":{"type":"string","pattern":"^asset:[a-z0-9_]+:sha256:[0-9a-f]{64}$"},"element":{"type":"object","x-schema-described":true,"required":["asset_ref","kind","index","alias"],"additionalProperties":{}}}},
  "requires":["context.open","model.dataset.list"],
  "consumes":["network.context","network.element"],
  "produces":["asset.reference","network.element.attributes"],
  "common_next":["topology.branch.endpoints.get","model.revision.derive","analysis.run"],
  "errors":["unknown_context","unknown_element_kind","unknown_element"],
  "recovery":{"unknown_context":["call context.open"],"unknown_element_kind":["call model.dataset.list"],"unknown_element":["call model.dataset.query for the selected table"]},
  "context_effect":{"requires_state":["model.active"],"consumes_state":["model.active"],"produces_state":["model.observation"],"invalidates_state":[],"result_kind":null,"projector":"model-observation-v1"},
  "state_effect":"none",
  "evidence_required":false,
  "risk":"read_only_model",
  "pandapower":{"version":"3.4.0","operation":"resolve schema-described rows from public static pandapowerNet tables","limitations":["Only model.dataset.list kinds and declared namespaces are accepted"]}
