{
  "id": "topology.branch.endpoints.get",
  "version": "1.0",
  "package": "grid_simulator",
  "tool_name": "grid_topology_branch_endpoints",
  "title": "Get branch endpoints",
  "purpose": "Return the two endpoint buses for a line or transformer branch in an opened context.",
  "applies_to": ["line endpoint questions", "branch-to-bus topology lookup", "pre-contingency verification"],
  "not_for": ["power-flow values", "loading percentages", "dynamic topology switching"],
  "terms": {
    "zh": ["线路两端母线", "支路端点", "拓扑连接", "母线名称"],
    "en": ["line endpoints", "branch endpoints", "topology connection", "bus names"]
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["context_ref", "branch_ref"],
    "properties": {
      "context_ref": {"type": "string", "pattern": "^context:sha256:[0-9a-f]{64}$"},
      "branch_ref": {"type": "string", "pattern": "^asset:(line|trafo|trafo3w):sha256:[0-9a-f]{64}$"}
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["context_ref", "branch_ref", "from_bus", "to_bus"],
    "properties": {
      "context_ref": {"type": "string", "pattern": "^context:sha256:[0-9a-f]{64}$"},
      "branch_ref": {"type": "string", "pattern": "^asset:(line|trafo|trafo3w):sha256:[0-9a-f]{64}$"},
      "from_bus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bus_ref", "index", "name"],
        "properties": {
          "bus_ref": {"type": "string", "pattern": "^asset:[a-z0-9_]+:sha256:[0-9a-f]{64}$"},
          "index": {"type": "integer", "minimum": 0},
          "name": {"type": "string"}
        }
      },
      "to_bus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bus_ref", "index", "name"],
        "properties": {
          "bus_ref": {"type": "string", "pattern": "^asset:[a-z0-9_]+:sha256:[0-9a-f]{64}$"},
          "index": {"type": "integer", "minimum": 0},
          "name": {"type": "string"}
        }
      }
    }
  },
  "requires": ["context.open", "model.element.get"],
  "consumes": ["network.context", "network.branch"],
  "produces": ["topology.endpoints", "network.bus"],
  "common_next": ["analysis.contingency.n_minus_one.run", "model.dataset.query"],
  "errors": ["unknown_context", "unknown_branch", "unsupported_branch_kind"],
  "recovery": {
    "unknown_context": ["call context.open for a supported model"],
    "unknown_branch": ["resolve the line or transformer with model.element.get"],
    "unsupported_branch_kind": ["use a line, trafo, or trafo3w branch reference"]
  },
  "state_effect": "none",
  "evidence_required": true,
  "risk": "read_only_model",
  "pandapower": {
    "version": "3.4.0",
    "operation": "read from_bus and to_bus from branch tables",
    "limitations": ["Reports static table endpoints, not switch-status-reduced topology"]
  }
}
