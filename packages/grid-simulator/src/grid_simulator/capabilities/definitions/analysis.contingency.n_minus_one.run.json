{
  "id": "analysis.contingency.n_minus_one.run",
  "version": "1.0",
  "package": "grid_simulator",
  "tool_name": "grid_analysis_contingency_n_minus_one",
  "title": "Run N-1 static contingency analysis",
  "purpose": "Run deterministic single-branch outage checks against an opened context and return scenario receipts with overload evidence.",
  "applies_to": ["single branch outage screening", "static security analysis", "post-powerflow overload checks"],
  "not_for": ["dynamic stability", "protection relay simulation", "inventing outage results without pandapower execution"],
  "terms": {
    "zh": ["N-1校核", "单一支路故障", "线路越限", "静态安全分析"],
    "en": ["N-1 contingency", "single branch outage", "line overload", "static security analysis"]
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["context_ref", "branch_refs", "policy"],
    "properties": {
      "context_ref": {"type": "string", "pattern": "^context:sha256:[0-9a-f]{64}$"},
      "branch_refs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^asset:(line|trafo|trafo3w):sha256:[0-9a-f]{64}$"}
      },
      "policy": {"type": "string", "enum": ["static-analysis-v1"]},
      "violation_types": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "enum": ["line_overload", "bus_voltage_low", "bus_voltage_high", "non_convergence"]}
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["result_ref", "context_ref", "policy", "scenarios"],
    "properties": {
      "result_ref": {"type": "string", "pattern": "^result:sha256:[0-9a-f]{64}$"},
      "context_ref": {"type": "string", "pattern": "^context:sha256:[0-9a-f]{64}$"},
      "policy": {"type": "string", "enum": ["static-analysis-v1"]},
      "scenarios": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch_ref", "converged", "violations", "evidence_ref"],
          "properties": {
            "branch_ref": {"type": "string", "pattern": "^asset:(line|trafo|trafo3w):sha256:[0-9a-f]{64}$"},
            "converged": {"type": "boolean"},
            "max_loading_percent": {"type": "number"},
            "violations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "severity"],
                "properties": {
                  "kind": {"type": "string", "enum": ["line_overload", "bus_voltage_low", "bus_voltage_high", "non_convergence"]},
                  "severity": {"type": "string", "enum": ["info", "warning", "critical"]},
                  "asset_ref": {"type": "string", "pattern": "^asset:[a-z0-9_]+:sha256:[0-9a-f]{64}$"},
                  "value": {"type": "number"},
                  "limit": {"type": "number"}
                }
              }
            },
            "evidence_ref": {"type": "string", "pattern": "^evidence:sha256:[0-9a-f]{64}$"}
          }
        }
      }
    }
  },
  "requires": ["context.open", "topology.branch.endpoints.get"],
  "consumes": ["network.context", "network.branch", "analysis.policy"],
  "produces": ["analysis.contingency.receipt", "analysis.violation", "evidence.record"],
  "common_next": ["result.branches.rank", "evidence.get"],
  "errors": ["unknown_context", "unknown_branch", "unsupported_policy", "powerflow_failed"],
  "recovery": {
    "unknown_context": ["call context.open for a supported model"],
    "unknown_branch": ["resolve branch identity with model.element.get or topology.branch.endpoints.get"],
    "powerflow_failed": ["report non-convergence and retrieve evidence"]
  },
  "state_effect": "creates_result",
  "evidence_required": true,
  "risk": "read_only_analysis",
  "pandapower": {
    "version": "3.4.0",
    "operation": "copy net, set branch in_service false, runpp",
    "limitations": ["AC steady-state only", "no dynamic stability or relay timing"]
  }
}
