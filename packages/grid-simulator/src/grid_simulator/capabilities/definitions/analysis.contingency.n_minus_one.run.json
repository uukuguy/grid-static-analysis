{
  "id": "analysis.contingency.n_minus_one.run",
  "version": "1.0",
  "package": "grid_simulator",
  "tool_name": "grid_analysis_contingency_n_minus_one",
  "availability": "published",
  "title": "Run N-1 static contingency analysis",
  "purpose": "Run deterministic single-branch outage checks against an immutable opened context and persist every scenario before returning the aggregate.",
  "applies_to": ["single branch outage screening", "static security analysis", "post-powerflow overload checks"],
  "not_for": ["dynamic stability", "protection relay simulation", "inventing outage results without pandapower execution"],
  "terms": {
    "zh": ["N-1校核", "单一支路故障", "线路越限", "静态安全分析"],
    "en": ["N-1 contingency", "single branch outage", "line overload", "static security analysis"]
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["context_ref", "branch_refs"],
    "properties": {
      "context_ref": {"type": "string", "pattern": "^context:sha256:[0-9a-f]{64}$"},
      "branch_refs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^asset:(line|trafo|trafo3w):sha256:[0-9a-f]{64}$"}
      },
      "solver_profile": {"type": "string", "enum": ["ac-default-v1"]},
      "algorithm": {"type": "string", "enum": ["nr", "iwamoto_nr", "bfsw"]},
      "calculate_voltage_angles": {"type": "boolean"},
      "init": {"type": "string", "enum": ["auto", "flat", "dc", "results"]},
      "max_iteration": {"type": "integer", "minimum": 1, "maximum": 100},
      "tolerance_mva": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
      "trafo_model": {"type": "string", "enum": ["t", "pi"]},
      "trafo_loading": {"type": "string", "enum": ["current", "power"]},
      "enforce_q_lims": {"type": "boolean"},
      "check_connectivity": {"type": "boolean"},
      "violation_types": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "enum": ["line_overload", "bus_voltage_low", "bus_voltage_high", "non_convergence"]}
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["result_ref", "context_ref", "revision_ref", "constraint_evaluation", "status", "solver", "evidence_refs", "scenarios"],
    "properties": {
      "result_ref": {"type": "string", "pattern": "^result:sha256:[0-9a-f]{64}$"},
      "context_ref": {"type": "string", "pattern": "^context:sha256:[0-9a-f]{64}$"},
      "revision_ref": {"type": "string", "pattern": "^revision:sha256:[0-9a-f]{64}$"},
      "constraint_evaluation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "source", "evaluated_quantities", "unevaluated_quantities"],
        "properties": {
          "status": {"type": "string", "enum": ["evaluated", "partially_evaluated", "not_defined"]},
          "source": {"type": "string", "enum": ["model"]},
          "evaluated_quantities": {"type": "array", "items": {"type": "string"}},
          "unevaluated_quantities": {"type": "array", "items": {"type": "string"}}
        }
      },
      "status": {"type": "string", "enum": ["succeeded", "partial", "failed"]},
      "solver": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "operation", "algorithm", "calculate_voltage_angles", "init", "max_iteration", "tolerance_mva", "trafo_model", "trafo_loading", "enforce_q_lims", "check_connectivity"],
        "properties": {
          "profile": {"type": "string", "enum": ["ac-default-v1"]},
          "operation": {"type": "string", "enum": ["pandapower.runpp"]},
          "algorithm": {"type": "string", "enum": ["nr", "iwamoto_nr", "bfsw"]},
          "calculate_voltage_angles": {"type": "boolean"},
          "init": {"type": "string", "enum": ["auto", "flat", "dc", "results"]},
          "max_iteration": {"type": "integer", "minimum": 1, "maximum": 100},
          "tolerance_mva": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "trafo_model": {"type": "string", "enum": ["t", "pi"]},
          "trafo_loading": {"type": "string", "enum": ["current", "power"]},
          "enforce_q_lims": {"type": "boolean"},
          "check_connectivity": {"type": "boolean"}
        }
      },
      "evidence_refs": {
        "type": "array",
        "items": {"type": "string", "pattern": "^evidence:sha256:[0-9a-f]{64}$"}
      },
      "scenarios": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenario_result_ref", "branch_ref", "element_kind", "pandapower_index", "status", "converged", "constraint_evaluation", "violations", "evidence_ref"],
          "properties": {
            "scenario_result_ref": {"type": "string", "pattern": "^result:sha256:[0-9a-f]{64}$"},
            "branch_ref": {"type": "string", "pattern": "^asset:(line|trafo|trafo3w):sha256:[0-9a-f]{64}$"},
            "element_kind": {"type": "string", "enum": ["line", "trafo", "trafo3w"]},
            "pandapower_index": {"type": "integer", "minimum": 0},
            "status": {"type": "string", "enum": ["succeeded", "non_converged"]},
            "converged": {"type": "boolean"},
            "max_loading_percent": {"type": "number"},
            "min_vm_pu": {"type": ["number", "null"]},
            "max_vm_pu": {"type": ["number", "null"]},
            "constraint_evaluation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "source", "evaluated_quantities", "unevaluated_quantities"],
              "properties": {
                "status": {"type": "string", "enum": ["evaluated", "partially_evaluated", "not_defined"]},
                "source": {"type": "string", "enum": ["model"]},
                "evaluated_quantities": {"type": "array", "items": {"type": "string"}},
                "unevaluated_quantities": {"type": "array", "items": {"type": "string"}}
              }
            },
            "violations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "severity", "asset_ref", "unit"],
                "properties": {
                  "kind": {"type": "string", "enum": ["line_overload", "bus_voltage_low", "bus_voltage_high", "non_convergence"]},
                  "severity": {"type": "string", "enum": ["info", "warning", "critical"]},
                  "asset_ref": {"type": "string", "pattern": "^asset:[a-z0-9_]+:sha256:[0-9a-f]{64}$"},
                  "element_kind": {"type": "string", "enum": ["line", "trafo", "trafo3w"]},
                  "pandapower_index": {"type": "integer", "minimum": 0},
                  "value": {"type": "number"},
                  "limit": {"type": "number"},
                  "unit": {"type": ["string", "null"], "enum": ["percent", "p.u.", null]},
                  "constraint_ref": {"type": "string", "pattern": "^constraint:sha256:[0-9a-f]{64}$"},
                  "constraint_source": {"type": "string", "enum": ["model"]}
                }
              }
            },
            "evidence_ref": {"type": "string", "pattern": "^evidence:sha256:[0-9a-f]{64}$"}
          }
        }
      }
    }
  },
  "requires": ["context.open", "topology.branch.endpoints.get"],
  "consumes": ["network.context", "network.branch", "model.constraint"],
  "produces": ["analysis.contingency.receipt", "analysis.raw_metric", "analysis.constraint_evaluation", "evidence.record"],
  "common_next": ["result.branches.rank", "evidence.get"],
  "errors": ["unknown_context", "unknown_branch", "powerflow_non_converged", "powerflow_failed", "persist_failed"],
  "recovery": {
    "unknown_context": ["call context.open for a supported model"],
    "unknown_branch": ["resolve branch identity with model.element.get or topology.branch.endpoints.get"],
    "powerflow_non_converged": ["inspect_network_diagnostics", "change_solver_profile", "report_non_convergence"],
    "powerflow_failed": ["report failure instead of estimating numeric values"],
    "persist_failed": ["retry after checking run workspace permissions"]
  },
  "context_effect": {
    "requires_state": ["model.active"],
    "consumes_state": ["model.active", "constraints.model"],
    "produces_state": ["scenarios.contingency", "calculations.contingency"],
    "invalidates_state": [],
    "result_kind": "contingency.n_minus_one",
    "projector": "contingency-n1-v1"
  },
  "state_effect": "creates_result",
  "evidence_required": true,
  "risk": "read_only_analysis",
  "pandapower": {
    "version": "3.4.0",
    "operation": "deep copy net, set one stable branch out of service, run pandapower.runpp",
    "limitations": ["AC steady-state only", "each scenario uses a fresh deep copy and partial aggregates keep successful scenario evidence"]
  }
}
