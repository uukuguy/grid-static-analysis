+function omitUndefined<T extends Record<string, unknown>>(value: T): Partial<T> {
+	const result: Record<string, unknown> = {};
+	for (const [key, entry] of Object.entries(value)) {
+		if (entry !== undefined) {
+			result[key] = entry;
+		}
+	}
+	return result as Partial<T>;
+}
+
