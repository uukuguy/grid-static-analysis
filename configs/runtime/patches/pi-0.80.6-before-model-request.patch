+function projectBeforeModelRequestModel(model: Model<Api>): PublicModelRequestModel {
+	return {
+		provider: model.provider,
+		api: model.api,
+		id: model.id,
+	};
+}
+
+function projectBeforeModelRequestContext(context: Context): PublicModelRequestContext {
+	const projected: PublicModelRequestContext = {
+		messages: structuredClone(context.messages),
+	};
+	if (context.systemPrompt !== undefined) {
+		projected.systemPrompt = context.systemPrompt;
+	}
+	if (context.tools !== undefined) {
+		projected.tools = context.tools.map((tool) => ({
+			name: tool.name,
+			description: tool.description,
+			parameters: structuredClone(tool.parameters),
+		}));
+	}
+	return projected;
+}
+
+function projectPublicModelRequestOptions(options: PublicModelRequestOptions): PublicModelRequestOptions {
+	const projected: PublicModelRequestOptions = {};
+	if (options.reasoning !== undefined) projected.reasoning = options.reasoning;
+	if (options.thinkingBudgets !== undefined) projected.thinkingBudgets = structuredClone(options.thinkingBudgets);
+	if (options.temperature !== undefined) projected.temperature = options.temperature;
+	if (options.maxTokens !== undefined) projected.maxTokens = options.maxTokens;
+	if (options.transport !== undefined) projected.transport = options.transport;
+	if (options.cacheRetention !== undefined) projected.cacheRetention = options.cacheRetention;
+	if (options.timeoutMs !== undefined) projected.timeoutMs = options.timeoutMs;
+	if (options.websocketConnectTimeoutMs !== undefined) {
+		projected.websocketConnectTimeoutMs = options.websocketConnectTimeoutMs;
+	}
+	if (options.maxRetries !== undefined) projected.maxRetries = options.maxRetries;
+	if (options.maxRetryDelayMs !== undefined) projected.maxRetryDelayMs = options.maxRetryDelayMs;
+	return projected;
+}
