@@ -0,0 +1,377 @@
+import { mkdirSync, mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+	type Api,
+	type AssistantMessage,
+	type Context,
+	createAssistantMessageEventStream,
+	type Model,
+	type SimpleStreamOptions,
+	Type,
+} from "@earendil-works/pi-ai";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { AuthStorage } from "../src/core/auth-storage.ts";
+import type {
+	BeforeModelRequestEvent,
+	ExtensionAPI,
+	ExtensionFactory,
+	ToolDefinition,
+} from "../src/core/extensions/index.ts";
+import { ModelRegistry } from "../src/core/model-registry.ts";
+import { DefaultResourceLoader } from "../src/core/resource-loader.ts";
+import { createAgentSession } from "../src/core/sdk.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { SettingsManager } from "../src/core/settings-manager.ts";
+
+describe("createAgentSession before_model_request extension event", () => {
+	let tempDir: string;
+	let cwd: string;
+	let agentDir: string;
+
+	beforeEach(() => {
+		tempDir = mkdtempSync(join(tmpdir(), "pi-sdk-before-model-request-"));
+		cwd = join(tempDir, "project");
+		agentDir = join(tempDir, "agent");
+		mkdirSync(cwd, { recursive: true });
+		mkdirSync(agentDir, { recursive: true });
+	});
+
+	afterEach(() => {
+		if (tempDir) {
+			rmSync(tempDir, { recursive: true, force: true });
+		}
+	});
+
+	function createModel(api: Api): Model<Api> {
+		return {
+			id: "capture-model",
+			name: "Capture Model",
+			api,
+			provider: "capture-provider",
+			baseUrl: "https://capture.invalid/v1",
+			reasoning: false,
+			headers: { "X-Private-Header": "secret" },
+			compat: { supportsStore: false, supportsDeveloperRole: false },
+			input: ["text"],
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+			contextWindow: 128000,
+			maxTokens: 4096,
+		};
+	}
+
+	function createDoneStream(api: Api) {
+		const stream = createAssistantMessageEventStream();
+		const message: AssistantMessage = {
+			role: "assistant",
+			content: [{ type: "text", text: "ok" }],
+			api,
+			provider: "capture-provider",
+			model: "capture-model",
+			usage: {
+				input: 0,
+				output: 0,
+				cacheRead: 0,
+				cacheWrite: 0,
+				totalTokens: 0,
+				cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+			},
+			stopReason: "stop",
+			timestamp: Date.now(),
+		};
+		stream.end(message);
+		return stream;
+	}
+
+	function gridModelListTool(): ToolDefinition {
+		return {
+			name: "grid_model_list",
+			label: "Grid model list",
+			description: "List available grid models.",
+			parameters: Type.Object({}),
+			execute: async () => ({ result: "[]" }),
+		};
+	}
+
+	async function createCaptureSession(options: {
+		extensionFactory: ExtensionFactory;
+		onProvider: (model: Model<Api>, context: Context, options?: SimpleStreamOptions) => void;
+	}) {
+		const api: Api = "openai-completions";
+		const model = createModel(api);
+		const settingsManager = SettingsManager.inMemory({ httpIdleTimeoutMs: 1234, websocketConnectTimeoutMs: 2345 });
+		const authStorage = AuthStorage.create(join(agentDir, "auth.json"));
+		authStorage.setRuntimeApiKey(model.provider, "test-api-key");
+		const modelRegistry = ModelRegistry.create(authStorage, join(agentDir, "models.json"));
+		modelRegistry.registerProvider(model.provider, {
+			api,
+			streamSimple: (streamModel, context, streamOptions) => {
+				options.onProvider(streamModel, context, streamOptions);
+				return createDoneStream(api);
+			},
+		});
+
+		const resourceLoader = new DefaultResourceLoader({
+			cwd,
+			agentDir,
+			settingsManager,
+			extensionFactories: [options.extensionFactory],
+		});
+		await resourceLoader.reload();
+
+		const created = await createAgentSession({
+			cwd,
+			agentDir,
+			model,
+			thinkingLevel: "medium",
+			authStorage,
+			modelRegistry,
+			settingsManager,
+			sessionManager: SessionManager.inMemory(cwd),
+			resourceLoader,
+			tools: ["grid_model_list"],
+			customTools: [gridModelListTool()],
+		});
+
+		return {
+			...created,
+			model,
+			dispose: () => {
+				created.session.dispose();
+				modelRegistry.unregisterProvider(model.provider);
+			},
+		};
+	}
+
+	it("emits a provider-neutral observation event before entering the provider", async () => {
+		const order: string[] = [];
+		let observed: BeforeModelRequestEvent | undefined;
+		const providerCall = vi.fn((_model: Model<Api>, _context: Context, _options?: SimpleStreamOptions) => {
+			order.push("provider");
+		});
+
+		const { session, model, dispose } = await createCaptureSession({
+			extensionFactory: (pi: ExtensionAPI) => {
+				pi.on("before_model_request", (event) => {
+					order.push("before_model_request");
+					observed = event;
+				});
+			},
+			onProvider: providerCall,
+		});
+
+		try {
+			await session.agent.streamFn(
+				model,
+				{
+					systemPrompt: "final system prompt",
+					messages: [{ role: "user", content: [{ type: "text", text: "question" }] }],
+					tools: [gridModelListTool()],
+				},
+				{
+					reasoning: "medium",
+					temperature: 0.2,
+					maxTokens: 1024,
+					transport: "sse",
+					cacheRetention: "short",
+					timeoutMs: 1234,
+					websocketConnectTimeoutMs: 2345,
+					maxRetries: 2,
+					maxRetryDelayMs: 3000,
+					apiKey: "caller-secret",
+					env: { SECRET_TOKEN: "secret" },
+					headers: { Authorization: "Bearer secret" },
+					signal: new AbortController().signal,
+					onPayload: () => undefined,
+					onResponse: () => undefined,
+					metadata: { trace: "transport-state" },
+					sessionId: "session-state",
+				},
+			);
+
+			expect(order).toEqual(["before_model_request", "provider"]);
+			expect(observed).toMatchObject({
+				type: "before_model_request",
+				model: {
+					provider: "capture-provider",
+					api: "openai-completions",
+					id: "capture-model",
+				},
+				context: {
+					systemPrompt: "final system prompt",
+					messages: [{ role: "user", content: [{ type: "text", text: "question" }] }],
+					tools: [{ name: "grid_model_list" }],
+				},
+				options: {
+					reasoning: "medium",
+					temperature: 0.2,
+					maxTokens: 1024,
+					transport: "sse",
+					cacheRetention: "short",
+					timeoutMs: 1234,
+					websocketConnectTimeoutMs: 2345,
+					maxRetries: 2,
+					maxRetryDelayMs: 3000,
+				},
+			});
+			for (const privateKey of [
+				"apiKey",
+				"env",
+				"headers",
+				"signal",
+				"onPayload",
+				"onResponse",
+				"metadata",
+				"sessionId",
+			]) {
+				expect(observed?.options).not.toHaveProperty(privateKey);
+			}
+		} finally {
+			dispose();
+		}
+	});
+
+	it("blocks the provider when the handler fails", async () => {
+		const providerCall = vi.fn();
+		const { session, model, dispose } = await createCaptureSession({
+			extensionFactory: (pi: ExtensionAPI) => {
+				pi.on("before_model_request", () => {
+					throw new Error("commit failed");
+				});
+			},
+			onProvider: providerCall,
+		});
+
+		try {
+			await expect(session.agent.streamFn(model, { messages: [] })).rejects.toThrow("commit failed");
+			expect(providerCall).toHaveBeenCalledTimes(0);
+		} finally {
+			dispose();
+		}
+	});
+
+	it("emits an LLM-visible tool snapshot without cloning executable callbacks", async () => {
+		let observed: BeforeModelRequestEvent | undefined;
+		const { session, model, dispose } = await createCaptureSession({
+			extensionFactory: (pi: ExtensionAPI) => {
+				pi.on("before_model_request", (event) => {
+					observed = event;
+				});
+			},
+			onProvider: vi.fn(),
+		});
+		const tool = gridModelListTool();
+
+		try {
+			await session.extensionRunner.emitBeforeModelRequest(
+				model,
+				{
+					systemPrompt: "final system prompt",
+					messages: [{ role: "user", content: [{ type: "text", text: "question" }] }],
+					tools: [tool],
+				},
+				{},
+			);
+
+			expect(observed?.context).toMatchObject({
+				systemPrompt: "final system prompt",
+				messages: [{ role: "user", content: [{ type: "text", text: "question" }] }],
+				tools: [
+					{ name: "grid_model_list", description: "List available grid models.", parameters: tool.parameters },
+				],
+			});
+			expect(observed?.context.tools?.[0]).not.toHaveProperty("execute");
+		} finally {
+			dispose();
+		}
+	});
+
+	it("projects runtime options to the public semantic request fields", async () => {
+		let observed: BeforeModelRequestEvent | undefined;
+		const { session, model, dispose } = await createCaptureSession({
+			extensionFactory: (pi: ExtensionAPI) => {
+				pi.on("before_model_request", (event) => {
+					observed = event;
+				});
+			},
+			onProvider: vi.fn(),
+		});
+
+		try {
+			await session.extensionRunner.emitBeforeModelRequest(model, { messages: [] }, {
+				reasoning: "medium",
+				thinkingBudgets: { medium: 2048 },
+				temperature: 0.2,
+				maxTokens: 1024,
+				transport: "sse",
+				cacheRetention: "short",
+				timeoutMs: 1234,
+				websocketConnectTimeoutMs: 2345,
+				maxRetries: 2,
+				maxRetryDelayMs: 3000,
+				apiKey: "caller-secret",
+				env: { SECRET_TOKEN: "secret" },
+				headers: { Authorization: "Bearer secret" },
+				signal: new AbortController().signal,
+				onPayload: () => undefined,
+				onResponse: () => undefined,
+				metadata: { trace: "transport-state" },
+				sessionId: "session-state",
+			} as SimpleStreamOptions);
+
+			expect(observed?.options).toEqual({
+				reasoning: "medium",
+				thinkingBudgets: { medium: 2048 },
+				temperature: 0.2,
+				maxTokens: 1024,
+				transport: "sse",
+				cacheRetention: "short",
+				timeoutMs: 1234,
+				websocketConnectTimeoutMs: 2345,
+				maxRetries: 2,
+				maxRetryDelayMs: 3000,
+			});
+			for (const privateKey of [
+				"apiKey",
+				"env",
+				"headers",
+				"signal",
+				"onPayload",
+				"onResponse",
+				"metadata",
+				"sessionId",
+			]) {
+				expect(observed?.options).not.toHaveProperty(privateKey);
+			}
+		} finally {
+			dispose();
+		}
+	});
+
+	it("projects model to public semantic identity only", async () => {
+		let observed: BeforeModelRequestEvent | undefined;
+		const { session, model, dispose } = await createCaptureSession({
+			extensionFactory: (pi: ExtensionAPI) => {
+				pi.on("before_model_request", (event) => {
+					observed = event;
+				});
+			},
+			onProvider: vi.fn(),
+		});
+
+		try {
+			await session.extensionRunner.emitBeforeModelRequest(model, { messages: [] }, {});
+
+			expect(observed?.model).toEqual({
+				provider: "capture-provider",
+				api: "openai-completions",
+				id: "capture-model",
+			});
+			for (const privateKey of ["headers", "compat", "baseUrl", "name", "cost", "contextWindow", "maxTokens"]) {
+				expect(observed?.model).not.toHaveProperty(privateKey);
+			}
+		} finally {
+			dispose();
+		}
+	});
+});
