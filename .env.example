# Copy this file to .env.  The real .env is ignored by Git.
# Select exactly one provider and set its corresponding key below.
GRID_AGENT_LLM_PROVIDER=openai
GRID_AGENT_LLM_MODEL=gpt-5.5
# Optional non-secret provider settings.
# GRID_AGENT_LLM_BASE_URL=
# GRID_AGENT_LLM_API_KEY_ENV=
# GRID_AGENT_LLM_TIMEOUT_SECONDS=180
# GRID_AGENT_LLM_MAX_RETRIES=2
# Optional OpenAI/OpenRouter headers (not secrets).
# GRID_AGENT_OPENAI_ORGANIZATION=
# GRID_AGENT_OPENAI_PROJECT=
# GRID_AGENT_OPENROUTER_HTTP_REFERER=
# GRID_AGENT_OPENROUTER_APP_NAME=
# Optional: use a locally installed Pi executable instead of the managed runtime.
# GRID_AGENT_PI_COMMAND=/absolute/path/to/pi
# Optional: override the simulator executable used by the offline path.
# GRID_AGENT_GRIDCTL_EXECUTABLE=

# OPENAI_API_KEY=replace-with-your-key
# OPENROUTER_API_KEY=replace-with-your-key
# DEEPSEEK_API_KEY=replace-with-your-key
# MINIMAX_API_KEY=replace-with-your-key
